DATABASE_URL=postgresql+psycopg://minutes:minutes@localhost:5432/minutesstudy
REDIS_URL=redis://localhost:6379/0
# Đổi thành chuỗi ngẫu nhiên dài khi chạy thật: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000

# Đăng nhập Google (tuỳ chọn): Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
#   Authorized JavaScript origins: http://localhost:3000 và https://<tên miền của bạn>
GOOGLE_CLIENT_ID=

# Lưu file: local (thư mục backend/storage, không cần MinIO) hoặc s3 (MinIO / S3 / R2)
STORAGE_BACKEND=local
# Object storage khi STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=minutesstudy
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Model routing: provider:model
# DeepSeek: deepseek-chat (nhanh) hoặc deepseek-reasoner (suy luận sâu)
MODEL_CHAT=deepseek:deepseek-chat
MODEL_GRADING=deepseek:deepseek-chat
# API DeepSeek không đọc được ảnh -> đọc ảnh viết tay vẫn cần model có vision
MODEL_VISION=gemini:gemini-2.5-flash
EMBEDDING_MODEL=none

# Lấy khoá tại https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Tuỳ chọn: chỉ cần nếu MODEL_* dùng provider tương ứng
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- AI & hàng đợi ----
# Tìm đoạn bài giảng: none = theo từ khoá BM25 (không cần thêm gì) | bge-m3 | openai:text-embedding-3-small
# Hàng đợi: inline = chạy nền trong API (dev) | celery = worker riêng qua Redis (production)
TASK_BACKEND=inline
AUTO_GRADE=true
CHAT_DAILY_LIMIT=60
BLUR_THRESHOLD=25
DEMO_CLASS_ON_SIGNUP=true

# Đọc ảnh viết tay: cần MỘT trong hai khoá dưới, và MODEL_VISION trỏ đúng provider
#   MODEL_VISION=gemini:gemini-2.5-flash  + GEMINI_API_KEY
#   MODEL_VISION=qwen:qwen-vl-max          + QWEN_API_KEY (DashScope)
QWEN_API_KEY=
OPENAI_API_KEY=

# Trợ lý AI giáo viên tổng hợp tài liệu tìm trên Google (tuỳ chọn): lấy khoá miễn phí tại https://serper.dev
#   (đăng nhập bằng tài khoản Google, có sẵn 2.500 lượt tìm miễn phí, không cần thẻ). Để trống = ẩn nút Google.
#   Không dùng Google Custom Search JSON API: Google đã đóng API này với khách hàng mới và ngừng hẳn từ 01/01/2027.
WEB_SEARCH_PROVIDER=serper
SERPER_API_KEY=
WEB_SEARCH_COUNTRY=vn
WEB_SEARCH_LANGUAGE=vi

# Giám sát lỗi (tuỳ chọn): Sentry DSN; LangSmith theo dõi LangGraph
SENTRY_DSN=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=minutesstudy
